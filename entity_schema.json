{
    "$schema": "https://json-schema.org/draft-07/schema",
    "$id": "https://example.com/entity_schema.json",
    "title": "JSON Schema for NanoCard Entities",
    "description": "Digital card battling game",
    "type": "object",
    "properties": {
        "name": {"type": "string"},
        "race": {
            "type": "string",
            "enum": ["Human", "Elf", "Dwarf", "Goblin", "Undead", "Skeleton", "Monster", "Giant", "Dragon"]
        },
        "class": {
            "type": "string",
            "enum": ["Warrior", "Mage", "Rogue", "Healer", "Ranger", "Tank"]
        },
        "element": {
            "type": "string",
            "enum": ["Fire", "Water", "Plant", "Earth", "Air", "Electric", "Light", "Dark"]
        },
        "health": {"type": "number"},
        "attack": {"type": "number"},
        "defense": {"type": "number"},
        "speed": {"type": "number"},
        "active_abilities": {
            "type": "array",
            "items": {
                "type": "object",
                "properties": {
                    "name": {"type": "string"},
                    "type": {
                        "type": "string",
                        "enum": ["attack"]
                    },
                    "element": {
                        "type": "string",
                        "enum": ["Fire", "Water", "Plant", "Earth", "Air", "Electric", "Light", "Dark"]
                    },
                    "amount": {"type": "number"}
                },
                "required": [ "name", "type", "element", "amount" ]
            }
        },
        "passive_abilities": {
            "type": "array",
            "items": {
                "type": "object",
                "properties": {
                    "name": {"type": "string"},
                    "type": {
                        "type": "string",
                        "enum": ["attack"]
                    },
                    "element": {
                        "type": "string",
                        "enum": ["Fire", "Water", "Plant", "Earth", "Air", "Electric", "Light", "Dark"]
                    },
                    "amount": {"type": "number"}
                },
                "required": [ "name", "type", "element", "amount" ]
            }
        }
    },
    "required": [ "name", "race", "class", "element", "health", "attack", "defense", "speed", "active_abilities", "passive_abilities" ]
}